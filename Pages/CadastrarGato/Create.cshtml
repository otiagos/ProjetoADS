@page
@model Gestao.Pages.CadastrarGato.CreateModel

@{ 
    ViewData["Title"] = "Create";
}
        
<h1 class="titulo">Cadastrar Gato</h1>
        
<div class="row">

    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Gato.CpfTutor" class="control-label"></label><br>
                <input asp-for="Gato.CpfTutor" class="form-control" aria-required="true"/>
                <span asp-validation-for="Gato.CpfTutor" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Gato.Nome" class="control-label"></label><br>
                <input asp-for="Gato.Nome" class="form-control" aria-required="true"/>
                <span asp-validation-for="Gato.Nome" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Gato.Idade" class="control-label"></label><br>
                <input asp-for="Gato.Idade" class="form-control" aria-required="true"/>
                <span asp-validation-for="Gato.Idade" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Gato.DataNascimento" class="control-label"></label><br>
                <input type="date" asp-for="Gato.DataNascimento" class="form-control" />
                <span asp-validation-for="Gato.DataNascimento" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Gato.IdRaca" class="control-label"></label>
                    <select asp-for="Gato.IdRaca" asp-items="ViewBag.IdRaca" class="form-control" aria-required="true">
                        <option value="">-- Selecione --</option>
                    </select>
                <span asp-validation-for="Gato.IdRaca" class="text-danger"></span><br/>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-success">Salvar</button> | 
                <button type="button" class="btn btn-secondary" onclick="location.href='@Url.Page("./Index")'">Retornar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
