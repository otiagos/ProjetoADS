@page
@model Gestao.Pages.CadastrarRaca.CreateModel

        @{
        ViewData["Title"] = "Create";
        }
        
        <h1 class="titulo">Cadastrar Raça</h1>
        
    <div class="row">
    <div class="col-md-4">
    <form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Raca.DescricaoRaca" class="control-label"></label><br/>
                <input asp-for="Raca.DescricaoRaca" class="form-control" />
                <span asp-validation-for="Raca.DescricaoRaca" class="text-danger"></span>
            </div>
            <div class="form-group">
                <button type="submit" class="botaoSalvar">Salvar</button>
            </div>
        </form>
    </div>
</div>

<div>
    <button type="button" class="botaoRetornar" onclick="location.href='@Url.Page("/Index")'">Retornar</button>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
