@page
@model Gestao.Pages.CadastrarTutor.CreateModel

        @{
        ViewData["Title"] = "Create";
        }
        
        <h1 class="titulo">Cadastrar Tutor</h1>
        
        <div class="row">
        <div class="col-md-4">
        <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <span class="text-danger">*</span>
            <label asp-for="Tutor.Nome" class="control-label"></label>
            <br/>
            <input asp-for="Tutor.Nome" class="form-control" aria-required="true"/>
            <span asp-validation-for="Tutor.Nome" class="text-danger"></span>
        </div>
        <div class="form-group">
            <span class="text-danger">*</span>
            <label asp-for="Tutor.CpfTutor" class="control-label"></label><br/>
            <input asp-for="Tutor.CpfTutor" class="form-control" aria-required="true"/>
            <span asp-validation-for="Tutor.CpfTutor" class="text-danger"></span>
        </div>
    <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Tutor.Telefone" class="control-label"></label><br/>
                <input asp-for="Tutor.Telefone" class="form-control" aria-required="true"/>
                <span asp-validation-for="Tutor.Telefone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Tutor.Endereco" class="control-label"></label><br/>
                <input asp-for="Tutor.Endereco" class="form-control" />
                <span asp-validation-for="Tutor.Endereco" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Tutor.DataNascimento" class="control-label"></label><br/>
                <input asp-for="Tutor.DataNascimento" type="date" class="form-control" aria-required="true"/>
                <span asp-validation-for="Tutor.DataNascimento" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Tutor.Email" class="control-label"></label><br/>
                <input asp-for="Tutor.Email" class="form-control" aria-required="true"/>
                <span asp-validation-for="Tutor.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <button type="submit" value="Create" class="botaoSalvar">Salvar</button>
            </div>
        </form>
    </div>
</div>

        <div>
    <button type="button" onclick="location.href='@Url.Page("./Index")'" class="botaoRetornar">Retornar</button>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
