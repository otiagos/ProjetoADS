@page
@model Gestao.Pages.CadastrarTutor.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Cadastrar Tutor</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Tutor[0].CpfTutor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tutor[0].Telefone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tutor[0].Endereco)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tutor[0].DataNascimento)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tutor[0].Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tutor[0].Nome)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Tutor) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CpfTutor)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Telefone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Endereco)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DataNascimento)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nome)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Atualizar</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Detalhes</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Excluir</a>
            </td>
        </tr>
}
    </tbody>
</table>
