@page
@model Gestao.Pages.CadastrarTutor.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Excluir</h1>

<h3>Excluir cadastro?</h3>
<div>
    <h4>Tutor</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Tutor.CpfTutor)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Tutor.CpfTutor)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Tutor.Telefone)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Tutor.Telefone)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Tutor.Endereco)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Tutor.Endereco)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Tutor.DataNascimento)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Tutor.DataNascimento)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Tutor.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Tutor.Email)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Tutor.Nome)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Tutor.Nome)
        </dd>
    </dl>
    
    <form method="post" onsubmit="return confirm('Clique em \'Ok\' para excluir')">
        <input type="hidden" asp-for="Tutor.Id" />
        <input type="submit" value="Excluir" class="btn btn-danger" /> |
        <a asp-page="./Index" class="btn btn-secondary">Retornar</a>
    </form>
</div>
