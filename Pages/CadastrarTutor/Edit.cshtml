@page
@model Gestao.Pages.CadastrarTutor.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Atualizar</h1>

<h4>Tutor</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Tutor.Nome" class="control-label"></label>
                <input asp-for="Tutor.Nome" class="form-control" aria-required="true"/>
                <span asp-validation-for="Tutor.Nome" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Tutor.CpfTutor" class="control-label"></label>
                <input asp-for="Tutor.CpfTutor" class="form-control" aria-required="true"/>
                <span asp-validation-for="Tutor.CpfTutor" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Tutor.Telefone" class="control-label"></label>
                <input asp-for="Tutor.Telefone" class="form-control" aria-required="true"/>
                <span asp-validation-for="Tutor.Telefone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Tutor.Endereco" class="control-label"></label>
                <input asp-for="Tutor.Endereco" class="form-control" />
                <span asp-validation-for="Tutor.Endereco" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Tutor.DataNascimento" class="control-label"></label>
                <input asp-for="Tutor.DataNascimento" class="form-control" aria-required="true"/>
                <span asp-validation-for="Tutor.DataNascimento" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Tutor.Email" class="control-label"></label>
                <input asp-for="Tutor.Email" class="form-control" aria-required="true"/><br/>
                <span asp-validation-for="Tutor.Email" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="Tutor.Id" />
            <div class="form-group">
                <input type="submit" value="Salvar" class="btn btn-primary" /> |
                <a asp-page="./Index" class="btn btn-secondary">Retornar</a>
            </div>
        </form>
    </div>
</div>

<script>
    document.getElementById('Tutor_CpfTutor').addEventListener('blur', async function () {
       const cpf = this.value.trim();
       const id = document.getElementById('Tutor_Id').value;
       const msg = document.getElementById('cpfMsg');
       msg.textContent = '';
       
       if (!cpf) return;
       
       const resp = await fetch(`?handler=VerificarCpfDuplicado&cpf=${encodeURIComponent(cpf)}&id=${id}`);
       const dados = await resp.json();
       
       if (dados.existe) {
           msg.textContent = 'CPF já cadastrado';
       }
    });
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
