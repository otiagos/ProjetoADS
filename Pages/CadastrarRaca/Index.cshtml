@page
@model Gestao.Pages.CadastrarRaca.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Cadastrar Raça</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Raca[0].DescricaoRaca)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Raca) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.DescricaoRaca)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Atualizar</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Detalhes</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Excluir</a>
            </td>
        </tr>
}
    </tbody>
</table>
